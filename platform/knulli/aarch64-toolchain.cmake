set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
# Path to a crosstool-NG aarch64 toolchain (e.g. tttapa/toolchains x-tools-aarch64-rpi3-linux-gnu).
set(XT "$ENV{AARCH64_XTOOLS}" CACHE PATH "aarch64 crosstool-NG root")
set(CMAKE_SYSROOT ${XT}/aarch64-rpi3-linux-gnu/sysroot)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET aarch64-rpi3-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-rpi3-linux-gnu)
set(CMAKE_C_FLAGS_INIT "--gcc-toolchain=${XT} -mcpu=cortex-a53")
set(CMAKE_CXX_FLAGS_INIT "--gcc-toolchain=${XT} -mcpu=cortex-a53")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld --gcc-toolchain=${XT}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld --gcc-toolchain=${XT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
